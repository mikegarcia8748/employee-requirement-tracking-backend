# `./kotlin run` on the host against the compose Postgres (ERT-1230).
#
#     docker compose up -d
#     set -a; . ./.env.local-pg; set +a; ./kotlin run
#
# This is the loop most development actually happens in: a real Postgres, and a
# JVM you can restart in seconds without rebuilding an image.
#
# Nothing loads this file. The application reads System.getenv directly and there
# is no dotenv library on the classpath, so `set -a` is what makes the assignments
# below visible to the process. Without it they are shell variables, the server
# sees nothing, and it refuses to start -- which looks exactly like the file not
# working.

APP_ENV=dev

# 55432 is the host-published port from docker-compose.yml, chosen so it does not
# collide with a Postgres already installed on the machine. Inside the compose
# network the same database is `postgres:5432`.
DATABASE_URL=jdbc:postgresql://localhost:55432/ert
DATABASE_USER=ert
DATABASE_PASSWORD=ert_local_dev_only
DATABASE_MAX_POOL_SIZE=5

PORTAL_BASE_URL=http://localhost:8080
MAIL_ENABLED=false
