# Environment for the containerised app in docker-compose (ERT-1230).
# Committed: it holds nothing secret, and DATABASE_* are supplied by the compose
# file itself so this stays the place for everything else.
#
# Unlike .env.dev, this file IS loaded -- compose's `env_file:` passes it to the
# container as real environment variables, which is the same shape Cloud Run
# uses. Nothing loads it for `./kotlin run`; that is what .env.local-pg is for.

# dev is opt-in since ERT-1120. Without this line the container resolves to
# production and refuses to start without JWT_SECRET and TOKEN_PEPPER -- which is
# the correct behaviour, and not what you want on a laptop.
APP_ENV=dev

# Five is plenty for one developer, and it is the value both Cloud Run services
# use -- the budget that matters is max_instances x this.
DATABASE_MAX_POOL_SIZE=5

PORTAL_BASE_URL=http://localhost:8080

# ERT-1010 has not shipped; the outbox holds everything and transmits nothing.
# Stated rather than omitted so nobody wonders why no mail arrives.
MAIL_ENABLED=false

# Off by default even here. It never logs arguments, so it carries no PIN, token,
# filename or email -- but it is a volume knob, and a noisy default trains people
# to stop reading the log.
# TRACE_USECASES=true

# Sign-in needs an account and the users table starts empty. Set both to have one
# created on first boot; in dev, leaving them unset warns rather than refusing.
# HR_BOOTSTRAP_EMAIL=hr.admin@example.test
# HR_BOOTSTRAP_PASSWORD=change-me-at-least-12-chars
