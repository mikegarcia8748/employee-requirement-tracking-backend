# Local development. Committed on purpose -- it holds no secret, and a fresh checkout that needs
# hand-set variables before it runs is the failure ERT-1120 traded away when it inverted the
# APP_ENV default.
#
# Nothing loads this file. The application reads System.getenv directly and there is no dotenv
# library on the classpath, so it has to be exported into the shell first:
#
#     set -a; . ./.env.dev; set +a; ./kotlin run
#
# `set -a` marks every subsequent assignment for export; `set +a` stops. Without it the values are
# shell variables, the process sees nothing, and the server refuses to start -- which looks exactly
# like the file not working.

# dev is opt-in. Unset means production (ERT-1120), which refuses to start without JWT_SECRET and
# TOKEN_PEPPER. This one line is what selects the permissive development configuration: /openapi,
# /swagger and /metrics open, an ephemeral signing key, an ephemeral token pepper.
APP_ENV=dev

# Left unset deliberately, so this file documents the dev defaults rather than duplicating them:
#
#   DATABASE_URL    unset -> in-memory H2 in PostgreSQL mode, wiped on exit
#   JWT_SECRET      unset -> a random key per process; tokens do not survive a restart
#   TOKEN_PEPPER    unset -> a random pepper per process; links do not survive a restart
#   PORTAL_BASE_URL unset -> http://localhost:8080
#
# For a real Postgres instead of H2, use .env.local-pg with `docker compose up -d` (ERT-1230).

# Use-case tracing is off by default even in dev, because it is a volume knob rather than a mode.
# Uncomment to see every use case entered and its outcome; it never logs arguments, so it carries no
# PIN, token, filename or email.
# TRACE_USECASES=true

# Sign-in needs an account, and the users table starts empty. Set both to have one created on first
# boot; leaving them unset in dev warns rather than refusing, and nobody can sign in.
# HR_BOOTSTRAP_EMAIL=hr.admin@example.test
# HR_BOOTSTRAP_PASSWORD=change-me-at-least-12-chars
